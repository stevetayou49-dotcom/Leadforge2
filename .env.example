# Port, auf dem der Server läuft
PORT=3001

# Geheimer Schlüssel für den Zugriff auf /api/anfragen (GET/PATCH/DELETE).
# Frei erfinden, z. B. mit: openssl rand -hex 24
# Diesen Wert später in LeadForge unter "Anfragen" eintragen.
# WICHTIG: Dies ist nur ein Platzhalter — niemals diesen (oder einen anderen
# aus einer öffentlichen Beispieldatei bekannten) Wert produktiv verwenden!
ADMIN_KEY=Langentepeo12!&

# Optional: E-Mail-Benachrichtigung bei neuer Anfrage.
# Leer lassen = Benachrichtigung ist aus, alles andere funktioniert trotzdem normal.
#
# Beispiel für Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=deine@gmail.com, SMTP_PASS=ein "App-Passwort" (nicht dein normales
# Passwort — unter Google-Konto > Sicherheit > App-Passwörter erzeugen).
# Auch Anbieter wie Resend oder Brevo funktionieren, dort SMTP-Zugangsdaten
# im jeweiligen Dashboard erzeugen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Wohin die Benachrichtigung geschickt wird (leer = an SMTP_USER selbst)
NOTIFY_EMAIL=
# Absenderadresse (leer = SMTP_USER)
SMTP_FROM=
